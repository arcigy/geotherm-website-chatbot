GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
GEMINI_RETRY_ATTEMPTS=1
LLM_REQUEST_TIMEOUT_MS=12000
LLM_FAST_REQUEST_TIMEOUT_MS=12000
LLM_PROVIDER=gemini
