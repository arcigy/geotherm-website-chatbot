ARCIGY_LLM_ENABLED=true
CHAT_API_HOST=0.0.0.0
CHAT_API_PORT=4317
ARCIGY_ALLOWED_ORIGINS=https://example.com,https://www.example.com
SESSION_TIMEOUT_SECONDS=7200
ARCIGY_PREVIEW_ENABLED=true
