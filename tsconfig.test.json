{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext", "dom"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".tmp-tests",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "scripts/test-geotherm-answer-planner.ts",
    "src/lib/geothermAnswerPlanner.ts",
    "src/lib/geothermConversation.ts",
    "src/lib/geothermEntityCatalog.ts",
    "src/lib/geothermTypes.ts",
    "src/data/geotherm-entities/*.json"
  ]
}
