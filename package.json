{
  "name": "arcigy-geotherm-chatbot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:wp-chatbot": "vite build --config vite.wp-chatbot.config.ts",
    "build:embed": "vite build --config vite.embed.config.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node .tmp-tests/scripts/test-geotherm-answer-planner.js && node scripts/test-geotherm-chat-api-shape.mjs && node scripts/test-geotherm-actions.mjs",
    "scrape:geotherm": "node scripts/scrape-geotherm.mjs",
    "kb:geotherm:archive": "node scripts/build-geotherm-knowledge-from-archive.mjs",
    "test:geotherm:v2": "node scripts/test-geotherm-chatbot-v2.mjs",
    "test:geotherm:actions": "node scripts/test-geotherm-actions.mjs",
    "export:wp-content": "tsc -p tsconfig.wp-export.json && node .tmp-wp-export/export-wordpress-content.js",
    "build:knowledge": "tsc -p tsconfig.wp-export.json && node .tmp-wp-export/build-chatbot-knowledge.js",
    "retrieve": "tsc -p tsconfig.wp-export.json && node .tmp-wp-export/retrieve-knowledge.js",
    "evaluate:retrieval": "tsc -p tsconfig.wp-export.json && node .tmp-wp-export/evaluate-retrieval.js",
    "dev:chat-api": "tsx scripts/chat-server.ts",
    "test:chat-api": "tsx scripts/test-chat-api.ts",
    "preview:embed": "vite dist-embed --host 127.0.0.1 --port 4321",
    "test:embed-ui": "tsx scripts/test-embed-ui.ts",
    "db:init": "tsx scripts/db-init.ts",
    "test:sales-flow": "tsx scripts/test-sales-flow.ts",
    "leads:list": "tsx scripts/leads-list.ts",
    "analytics:report": "tsx scripts/analytics-report.ts",
    "security:self-check": "tsx scripts/security-self-check.ts",
    "test:wp-plugin": "node scripts/test-wp-plugin.mjs"
  },
  "dependencies": {
    "@google/genai": "1.51.0",
    "cheerio": "^1.2.0",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.4",
    "playwright": "^1.59.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.11"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
